# Copy to credentials.env and fill in.

# ---- Firefox (optional; only if Firefox is installed in a non-standard folder) ----
# FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe

# ---- Oracle BI (Approval Report HO / Branch) ----
ORACLE_URL=
ORACLE_USERNAME=
ORACLE_PASSWORD=

# ---- SmartOps ERP (Credit Score Decision / RBP Security Approved) ----
ERP_URL=
ERP_USERNAME=
ERP_PASSWORD=
# Months of decisions pulled before the reporting period start
DECISION_LOOKBACK_MONTHS=3

# ---- SMTP ----
SMTP_SERVER=
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- Recipient groups by mode (comma or semicolon separated) ----
DAILY_GROUP=
CUMULATIVE_GROUP=
MONTHLY_GROUP=
N_MONTHS_GROUP=
CUSTOM_GROUP=
# Rental Shortfall Report (main_orchestrator.py --report rental-shortfall)
THREE_MONTHS_RENTAL_ANALYSIS_GROUP=
# Rental Shortfall & 90 DPD Analysis (main_orchestrator.py --report rental-dpd)
RENTAL_90DPD_ANALYSIS_GROUP=
# Data-request alerts, 2 days before each rental report (data_request_alert.py)
DATA_PROVIDER=
# Weekly mode has no group yet; set this to email weekly runs
# WEEKLY_GROUP=
# Optional: who is told when a run fails
APPR_AF_ERROR_TO=

# ---- Existing / New Customer (BRANCH DISBURSEMENT OLD history) ----
# Look-back after a facility closes, and the longest facility tenor
# (history download From = period start - look-back - max tenor)
EXISTING_LOOKBACK_MONTHS=3
HISTORY_MAX_TENOR_MONTHS=84

# ---- SmartOps ERP: longest From-To range per export (days); longer ranges are split ----
ERP_MAX_RANGE_DAYS=90
# Days per ERP download piece (the ERP export times out after 360 s on big ranges).
# A piece that still times out is split in half automatically, down to ERP_MIN_PIECE_DAYS.
ERP_PIECE_DAYS=15
ERP_MIN_PIECE_DAYS=1
# Retries for a piece that returns any other error page
ERP_PIECE_RETRIES=1
# Seconds to wait for a piece's file; none by then -> Firefox restarted, piece split in half
ERP_DOWNLOAD_TIMEOUT=600
# Seconds to wait for the report screen's dropdowns to load
ERP_SCREEN_TIMEOUT=30

# Rental Shortfall & 90 DPD Analysis: interest-rate column for the Auto Finance 'Rate'
# (looked up in BRANCH DISBURSEMENT OLD, then in the as-at month's LENDING csv)
DPD_RATE_COL=INTEREST_RATE
