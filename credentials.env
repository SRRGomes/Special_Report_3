ERP_MIN_PIECE_DAYS=1
# Retries for a piece that returns any other error page
ERP_PIECE_RETRIES=1
# Seconds to wait for a piece's file; none by then -> Firefox restarted, piece split in half
ERP_DOWNLOAD_TIMEOUT=600
# Seconds to wait for the report screen's dropdowns to load
ERP_SCREEN_TIMEOUT=60

